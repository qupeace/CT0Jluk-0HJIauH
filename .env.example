# Образец переменных окружения. Реальные значения хранить только в файле .env
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# База данных
DATABASE_URL=postgresql://stolik:change_me@localhost:5432/stolik

# Redis (временное удержание столиков)
REDIS_URL=redis://localhost:6379
BOOKING_HOLD_MINUTES=15

# Аутентификация
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=15m

# Почта (уведомления о бронях)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Платёжный провайдер (предоплата при бронировании)
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=
